# Store the real values only on the server, preferably in:
# /etc/kuaiyu-site/homeostasis-test-ai.env
# Never commit an API key to this repository.
HOMEOSTASIS_AI_API_KEY=replace-with-a-rotated-key
HOMEOSTASIS_AI_ENDPOINT=https://tokenhub.tencentmaas.com/v1/chat/completions
HOMEOSTASIS_AI_MODEL=deepseek-v4-pro
HOMEOSTASIS_AI_THINKING=enabled
HOMEOSTASIS_AI_TIMEOUT_MS=110000
HOMEOSTASIS_AI_MAX_TOKENS=9000
HOMEOSTASIS_AI_RATE_LIMIT_MAX=6
HOMEOSTASIS_AI_DAILY_LIMIT=3
HOMEOSTASIS_AI_QUOTA_PATH=/var/lib/kuaiyu-site/homeostasis-test-ai-quota.json
HOMEOSTASIS_AI_QUOTA_SALT=replace-with-a-long-random-value
HOMEOSTASIS_AI_QUOTA_ACTION_RATE_LIMIT_MAX=60
