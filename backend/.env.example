# HomeoXNet backend configuration.
#
# Copy to a file OUTSIDE the repository, fill in real values, and source it before starting the
# server. Never commit a filled-in copy: `.gitignore` excludes `.env*`, but only this `.env.example`
# is meant to be tracked.
#
#   cp backend/.env.example /etc/homeoxnet.env   # then edit it
#   set -a; . /etc/homeoxnet.env; set +a; npm start
#
# Every variable below is OPTIONAL. With none of them set, the simulator runs fully; only the AI
# report is unavailable.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# PORT=3002
# FRONTEND_PATH=../frontend
# CORS_ORIGIN=*

# ---------------------------------------------------------------------------
# AI case analysis (optional)
# ---------------------------------------------------------------------------
# Any OpenAI-compatible /v1/chat/completions endpoint works. The report is disabled unless
# HOMEOSTASIS_AI_API_KEY is set; check GET /api/health -> medicalAiConfigured.
#
# Provider module: unset (default) = medicalAi.js, `kimi` = medicalAiKimi.js.
# HOMEOSTASIS_AI_PROVIDER=kimi

HOMEOSTASIS_AI_API_KEY=replace-with-your-own-key
# Default endpoint/model belong to the default provider module; override for your own provider.
# HOMEOSTASIS_AI_ENDPOINT=https://api.openai.com/v1/chat/completions
# HOMEOSTASIS_AI_MODEL=gpt-4o
# `disabled` turns off extended reasoning for providers that support it.
# HOMEOSTASIS_AI_THINKING=enabled
# HOMEOSTASIS_AI_TIMEOUT_MS=110000
# A full report is long; below ~7000 the last sections get truncated.
# HOMEOSTASIS_AI_MAX_TOKENS=9000

# --- Cost control. These are what stand between a public deployment and your API bill. ---
# Reports per visitor per day (resets at midnight Asia/Shanghai).
# HOMEOSTASIS_AI_DAILY_LIMIT=3
# Requests per IP per 30 minutes.
# HOMEOSTASIS_AI_RATE_LIMIT_MAX=6
# Where the per-visitor daily counter is persisted. Defaults to backend/logs/ so a clone works
# without root; point it somewhere durable for a real deployment, or the quota resets on redeploy.
# HOMEOSTASIS_AI_QUOTA_PATH=/var/lib/homeoxnet/homeostasis-ai-quota.json
# Visitor IPs are stored only as HMACs of this salt. Set a long random value in production;
# changing it resets everyone's quota.
# HOMEOSTASIS_AI_QUOTA_SALT=replace-with-a-long-random-value
# HOMEOSTASIS_AI_QUOTA_ACTION_RATE_LIMIT_MAX=60
# Session-quality gate: a session too thin to analyse never reaches the model, so it costs
# nothing. Measured in REAL seconds - the time lens compresses simulated time up to ~11500x.
# Set HOMEOSTASIS_AI_ELIGIBILITY=off to disable the gate entirely.
# HOMEOSTASIS_AI_ELIGIBILITY=on
# Distinct learner actions required. A loaded scenario is one action, not one per parameter.
# HOMEOSTASIS_AI_MIN_ACTIONS=3
# Real seconds of observation required, summed across the time lenses.
# HOMEOSTASIS_AI_MIN_WATCHED_SECONDS=90
# Longest stretch the learner must leave the system alone at least once, in real seconds.
# HOMEOSTASIS_AI_MIN_QUIET_GAP_SECONDS=20

# ---------------------------------------------------------------------------
# Classroom analytics (optional, OFF by default)
# ---------------------------------------------------------------------------
# Leave this unset and the app records nothing: no visitor id, no IP, no click stream, and the
# browser makes no logging request at all. Set it to 1 and the server writes one JSONL row per
# learner action -- including the visitor's IP address and a persistent browser id -- plus the full
# AI evidence pack for every session. That is genuinely useful for teaching, and it is personal
# data: turn it on only where you have told your users, and check your local rules first.
# HOMEOSTASIS_LEARNING_LOG_ENABLED=1
# HOMEOSTASIS_LEARNING_LOG_PATH=/var/log/homeoxnet/homeostasis-learning-events.jsonl

# ---------------------------------------------------------------------------
# Rate limits (optional; defaults are sized for real users)
# ---------------------------------------------------------------------------
# Raise these only for scripted/automated runs -- a browser tick loop trips the defaults in a minute.
# HOMEOSTASIS_SESSION_RATE_LIMIT_WINDOW_MS=10000
# HOMEOSTASIS_START_RATE_LIMIT_MAX=180
# HOMEOSTASIS_TICK_RATE_LIMIT_MAX=80
# HOMEOSTASIS_ACTION_RATE_LIMIT_MAX=180
# HOMEOSTASIS_INVALID_SESSION_RATE_LIMIT_MAX=120
# HOMEOSTASIS_REPORT_RATE_LIMIT_MAX=20
# HOMEOSTASIS_LEARNING_RATE_LIMIT_MAX=360
# HOMEOSTASIS_AI_PROMPT_LOG_RATE_LIMIT_MAX=30
